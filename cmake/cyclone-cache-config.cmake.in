# Package config for find_package(cyclone-cache): defines the imported
# target cyclone::cyclone-cache.

include(CMakeFindDependencyMacro)

set(THREADS_PREFER_PTHREAD_FLAG ON)
find_dependency(Threads)

# ON when this installation is a static library built with the OpenSSL key
# hash (-DCYCLONE_USE_BUNDLED_SHA256=OFF): the application then links
# libcrypto as well.  The default build hashes with the bundled SHA-256 and
# needs no crypto library.
if(@CYCLONE_CONFIG_NEEDS_OPENSSL@)
  find_dependency(OpenSSL)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/cyclone-cache-targets.cmake")
