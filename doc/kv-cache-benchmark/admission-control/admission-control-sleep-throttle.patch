+std::unique_ptr<WriteAdmission> WriteAdmission::for_file(
+    const WriteAdmissionParams& params, int fd) {
+  struct stat st{};
+  if (fd < 0 || ::fstat(fd, &st) != 0 || major(st.st_dev) == 0) {
+    return nullptr;  // no backing block device (tmpfs, overlay, btrfs subvol)
+  }
+  std::array<char, 64> path{};
+  std::snprintf(path.data(), path.size(), "/sys/dev/block/%u:%u/stat",
+                major(st.st_dev), minor(st.st_dev));
+  const int sfd = ::open(path.data(), O_RDONLY | O_CLOEXEC);
+  if (sfd < 0) {
+    return nullptr;
+  }
+  auto stat_file = std::make_shared<SysfsBlockStat>(sfd);
+  if (!stat_file->read()) {
+    return nullptr;
+  }
+  return std::make_unique<WriteAdmission>(
+      params, [stat_file] { return stat_file->read(); }, steady_now_ns,
+      [](uint64_t ns) {
+        std::this_thread::sleep_for(std::chrono::nanoseconds(ns));
+      });
+}
+#else
+std::unique_ptr<WriteAdmission> WriteAdmission::for_file(
+    const WriteAdmissionParams& /*params*/, int /*fd*/) {
+  return nullptr;  // no device read counters on this platform
+}
+#endif
+
+}  // namespace cyclone
diff --git a/src/core/write_admission.hpp b/src/core/write_admission.hpp
new file mode 100644
index 0000000..35b94a0
--- /dev/null
+++ b/src/core/write_admission.hpp
@@ -0,0 +1,146 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2024-2026 We-Amp B.V.
+
+#pragma once
+
+// Writer admission control driven by device read latency (issue #43;
+// doc/design/writer-admission-control.md).  Opt-in through
+// CacheConfig::write_admission.
+//
+// A large write is delayed before it takes any lock when the volume
+// device's reads are queueing: the delay is proportional to how far the
+// smoothed read await is above a target, and bounded.  The signal is the
+// kernel's per-device read counters (Linux: /sys/dev/block/MAJ:MIN/stat),
+// sampled by writers only, at most once per window, by whichever writer
+// wins a try_lock.  Readers are not involved.
+//
+// WriteAdmissionController is the pure control law (time and counters are
+// passed in, so unit tests drive it deterministically).  WriteAdmission
+// wires it to a counter source, a clock and a sleeper, all injectable.
+
+#include <atomic>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <optional>
+
+namespace cyclone {
+
+// Cumulative read counters of one block device, as the kernel reports them.
+struct DeviceReadSample {
+  uint64_t reads = 0;    // reads completed
+  uint64_t read_ms = 0;  // total time those reads spent, in milliseconds
+};
+
+struct WriteAdmissionParams {
+  // Throttling starts when the smoothed read await exceeds this.
+  uint64_t target_ns = 2'000'000;
+  // Delay per unit of excess await: delay = gain * (await - target).
+  double gain = 2.0;
+  // Upper bound on the delay of one write.
+  uint64_t max_delay_ns = 10'000'000;
+  // A window closes after at least window_ns and at least min_reads reads.
+  uint64_t window_ns = 50'000'000;
+  uint64_t min_reads = 16;
+  // A window still open after idle_ns (too few reads: the device is idle for
+  // reads; or no writer sampled for that long) resets the estimate and the
+  // delay to zero.
+  uint64_t idle_ns = 1'000'000'000;
+};
+
+class WriteAdmissionController {
+ public:
+  explicit WriteAdmissionController(const WriteAdmissionParams& params)
+      : _params(params) {}
+
+  // Feed the device's cumulative counters at time now_ns.  Returns true when
+  // the sample closed a window (the delay may have changed).
+  bool observe(uint64_t now_ns, DeviceReadSample sample);
+
+  // The delay to apply before the next large write, in nanoseconds.
+  [[nodiscard]] uint64_t delay_ns() const noexcept { return _delay_ns; }
+  // The smoothed read await, in nanoseconds (0 when there is no estimate).
+  [[nodiscard]] uint64_t await_ns() const noexcept {
+    return _have_ewma ? static_cast<uint64_t>(_ewma_ns) : 0;
+  }
+
+ private:
+  void rebase(uint64_t now_ns, DeviceReadSample sample) noexcept {
+    _have_base = true;
+    _base_ns = now_ns;
+    _base = sample;
+  }
+  void reset(uint64_t now_ns, DeviceReadSample sample) noexcept {
+    _have_ewma = false;
+    _ewma_ns = 0;
+    _delay_ns = 0;
+    rebase(now_ns, sample);
+  }
+
+  WriteAdmissionParams _params;
+  bool _have_base = false;
+  uint64_t _base_ns = 0;
+  DeviceReadSample _base;
+  bool _have_ewma = false;
+  double _ewma_ns = 0;
+  uint64_t _delay_ns = 0;
+};
+
+class WriteAdmission {
+ public:
+  using CounterSource = std::function<std::optional<DeviceReadSample>()>;
+  using NowNs = std::function<uint64_t()>;
+  using Sleeper = std::function<void(uint64_t ns)>;
+
+  // Test / injection constructor.
+  WriteAdmission(const WriteAdmissionParams& params, CounterSource counters,
+                 NowNs now, Sleeper sleep);
+
+  // The production instance for the device holding `fd`: nullptr when the
+  // device's read counters are not available (non-Linux, a file system with
+  // no backing block device such as tmpfs or overlay, no /sys).
+  static std::unique_ptr<WriteAdmission> for_file(
+      const WriteAdmissionParams& params, int fd);
+
+  // Called before a large write, with no lock held.  Samples the device if a
+  // window is due (never waits for another sampler), then sleeps for the
+  // current delay.  Returns the delay slept, in nanoseconds.
+  uint64_t admit();
+
+  // Telemetry (process-local).
+  [[nodiscard]] uint64_t delays() const noexcept {
+    return _delays.load(std::memory_order_relaxed);
+  }
+  [[nodiscard]] uint64_t delay_ns_total() const noexcept {
+    return _delay_ns_total.load(std::memory_order_relaxed);
+  }
+  [[nodiscard]] uint64_t await_ns() const noexcept {
+    return _await_ns.load(std::memory_order_relaxed);
+  }
+
+ private:
+  void maybe_sample(uint64_t now_ns);
+
+  CounterSource _counters;
+  NowNs _now;
+  Sleeper _sleep;
+  uint64_t _window_ns;
+
+  // Writer-only state.  The controller is touched only under _sample_mutex
+  // (try_lock: a writer that loses simply uses the published delay).
+  std::mutex _sample_mutex;
+  WriteAdmissionController _controller;
+
+  // Published for every writer: one line, touched by writers only.
+  struct alignas(128) Published {
+    std::atomic<uint64_t> delay_ns{0};
+    std::atomic<uint64_t> next_sample_ns{0};
+  };
+  Published _pub;
+  std::atomic<uint64_t> _await_ns{0};
+  std::atomic<uint64_t> _delays{0};
+  std::atomic<uint64_t> _delay_ns_total{0};
+};
+
+}  // namespace cyclone
diff --git a/tests/unit/test_write_admission.cpp b/tests/unit/test_write_admission.cpp
new file mode 100644
index 0000000..9c673ad
--- /dev/null
+++ b/tests/unit/test_write_admission.cpp
@@ -0,0 +1,292 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2024-2026 We-Amp B.V.
+
+// Writer admission control (issue #43, doc/design/writer-admission-control.md).
+// The control law is driven with synthetic device counters and an injected
+// clock, so every expected delay is exact.
+
+#include <atomic>
+#include <catch2/catch_test_macros.hpp>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "core/write_admission.hpp"
+#include "cyclone/cache.hpp"
+#include "cyclone/key.hpp"
+#include "support/temp_cache.hpp"
+
+using namespace cyclone;
+
+namespace {
+
+constexpr uint64_t kMs = 1'000'000;  // ns
+
+WriteAdmissionParams params() {
+  WriteAdmissionParams p;
+  p.target_ns = 2 * kMs;
+  p.gain = 2.0;
+  p.max_delay_ns = 10 * kMs;
+  p.window_ns = 50 * kMs;
+  p.min_reads = 16;
+  p.idle_ns = 1000 * kMs;
+  return p;
+}
+
+// Feeds windows of `reads` reads at `await_ms` each, `window_ms` apart.
+struct Device {
+  uint64_t now_ns = 0;
+  DeviceReadSample c{1000, 5000};
+  bool step(WriteAdmissionController& ctl, uint64_t window_ms, uint64_t reads,
+            uint64_t await_ms) {
+    now_ns += window_ms * kMs;
+    c.reads += reads;
+    c.read_ms += reads * await_ms;
+    return ctl.observe(now_ns, c);
+  }
+};
+
+}  // namespace
+
+TEST_CASE("Write admission: no delay at or below the target",
+          "[write_admission]") {
+  WriteAdmissionController ctl(params());
+  Device d;
+  REQUIRE_FALSE(ctl.observe(d.now_ns, d.c));  // baseline only
+  REQUIRE(ctl.delay_ns() == 0);
+  REQUIRE(d.step(ctl, 50, 100, 1));
+  REQUIRE(ctl.await_ns() == 1 * kMs);
+  REQUIRE(ctl.delay_ns() == 0);
+  REQUIRE(d.step(ctl, 50, 100, 2));  // EWMA 1.25 ms: still below
+  REQUIRE(ctl.delay_ns() == 0);
+}
+
+TEST_CASE("Write admission: delay is gain x excess over the smoothed await",
+          "[write_admission]") {
+  WriteAdmissionController ctl(params());
+  Device d;
+  ctl.observe(d.now_ns, d.c);
+  // First window seeds the average: 4 ms -> excess 2 ms -> delay 4 ms.
+  REQUIRE(d.step(ctl, 50, 200, 4));
+  REQUIRE(ctl.await_ns() == 4 * kMs);
+  REQUIRE(ctl.delay_ns() == 4 * kMs);
+  // Then a quarter step per window: 4 + (2 - 4) / 4 = 3.5 ms -> 3 ms delay.
+  REQUIRE(d.step(ctl, 50, 200, 2));
+  REQUIRE(ctl.await_ns() == 3'500'000);
+  REQUIRE(ctl.delay_ns() == 3 * kMs);
+  // 3.5 + (2 - 3.5) / 4 = 3.125 ms -> 2.25 ms delay.
+  REQUIRE(d.step(ctl, 50, 200, 2));
+  REQUIRE(ctl.delay_ns() == 2'250'000);
+  // The output is continuous: it decays toward 0, never steps there.
+  uint64_t last = ctl.delay_ns();
+  for (int i = 0; i < 40; ++i) {
+    d.step(ctl, 50, 200, 2);
+    REQUIRE(ctl.delay_ns() <= last);
+    last = ctl.delay_ns();
+  }
+  REQUIRE(last < 1000);  // under a microsecond after 40 windows at target
+}
+
+TEST_CASE("Write admission: the delay is bounded by max_delay",
+          "[write_admission]") {
+  WriteAdmissionController ctl(params());
+  Device d;
+  ctl.observe(d.now_ns, d.c);
+  REQUIRE(d.step(ctl, 50, 100, 50));  // 50 ms reads: 96 ms raw delay
+  REQUIRE(ctl.delay_ns() == 10 * kMs);
+}
+
+TEST_CASE("Write admission: a window needs both time and reads",
+          "[write_admission]") {
+  WriteAdmissionController ctl(params());
+  Device d;
+  ctl.observe(d.now_ns, d.c);
+  // Too soon: nothing closes, whatever the counters say.
+  REQUIRE_FALSE(d.step(ctl, 10, 1000, 9));
+  REQUIRE(ctl.delay_ns() == 0);
+  // Due, but the window holds 1000 + 5 reads... closes (reads accumulate
+  // across the early sample, which did not rebase).
+  REQUIRE(d.step(ctl, 40, 5, 9));
+  REQUIRE(ctl.await_ns() == 9 * kMs);
+  // Now a window with too few reads is extended, not closed.
+  REQUIRE_FALSE(d.step(ctl, 60, 10, 1));
+  REQUIRE(ctl.await_ns() == 9 * kMs);
+  // ...until it holds enough: 10 + 10 reads at 1 ms.
+  REQUIRE(d.step(ctl, 60, 10, 1));
+  REQUIRE(ctl.await_ns() == 7 * kMs);  // 9 + (1 - 9) / 4
+}
+
+TEST_CASE("Write admission: an idle device resets the delay to zero",
+          "[write_admission]") {
+  WriteAdmissionController ctl(params());
+  Device d;
+  ctl.observe(d.now_ns, d.c);
+  REQUIRE(d.step(ctl, 50, 100, 6));
+  REQUIRE(ctl.delay_ns() == 8 * kMs);
+  // Few reads for a whole second: extended windows, then a reset.
+  for (int i = 0; i < 19; ++i) {
+    REQUIRE_FALSE(d.step(ctl, 50, 0, 0));
+    REQUIRE(ctl.delay_ns() == 8 * kMs);
+  }
+  REQUIRE(d.step(ctl, 50, 0, 0));
+  REQUIRE(ctl.delay_ns() == 0);
+  REQUIRE(ctl.await_ns() == 0);
+  // The next estimate starts fresh (no memory of 6 ms).
+  REQUIRE(d.step(ctl, 50, 100, 3));
+  REQUIRE(ctl.await_ns() == 3 * kMs);
+  REQUIRE(ctl.delay_ns() == 2 * kMs);
+}
+
+TEST_CASE("Write admission: a long gap between writers resets the estimate",
+          "[write_admission]") {
+  WriteAdmissionController ctl(params());
+  Device d;
+  ctl.observe(d.now_ns, d.c);
+  REQUIRE(d.step(ctl, 50, 100, 6));
+  REQUIRE(ctl.delay_ns() == 8 * kMs);
+  // Nobody sampled for 5 s, although the device was busy: stale, reset.
+  REQUIRE(d.step(ctl, 5000, 100000, 8));
+  REQUIRE(ctl.delay_ns() == 0);
+}
+
+TEST_CASE("Write admission: counters going backwards restart the estimate",
+          "[write_admission]") {
+  WriteAdmissionController ctl(params());
+  Device d;
+  ctl.observe(d.now_ns, d.c);
+  REQUIRE(d.step(ctl, 50, 100, 6));
+  REQUIRE(ctl.delay_ns() > 0);
+  d.now_ns += 50 * kMs;
+  REQUIRE(ctl.observe(d.now_ns, DeviceReadSample{1, 1}));
+  REQUIRE(ctl.delay_ns() == 0);
+}
+
+TEST_CASE("Write admission: admit samples once per window and sleeps the delay",
+          "[write_admission]") {
+  uint64_t now = 0;
+  int samples = 0;
+  DeviceReadSample c{0, 0};
+  std::vector<uint64_t> slept;
+  WriteAdmission wa(
+      params(),
+      [&]() -> std::optional<DeviceReadSample> {
+        ++samples;
+        return c;
+      },
+      [&] { return now; }, [&](uint64_t ns) { slept.push_back(ns); });
+
+  REQUIRE(wa.admit() == 0);  // baseline sample
+  REQUIRE(samples == 1);
+  // Within the window: no new sample, however many writes.
+  for (int i = 0; i < 100; ++i) {
+    now += kMs / 4;
+    REQUIRE(wa.admit() == 0);
+  }
+  REQUIRE(samples == 1);
+  // The device turns slow (5 ms reads); the next due sample sees it.
+  c.reads += 100;
+  c.read_ms += 500;
+  now = 50 * kMs;
+  REQUIRE(wa.admit() == 6 * kMs);  // 2 x (5 - 2)
+  REQUIRE(samples == 2);
+  REQUIRE(slept == std::vector<uint64_t>{6 * kMs});
+  now += kMs;
+  REQUIRE(wa.admit() == 6 * kMs);  // published delay, no new sample
+  REQUIRE(samples == 2);
+  REQUIRE(wa.delays() == 2);
+  REQUIRE(wa.delay_ns_total() == 12 * kMs);
+  REQUIRE(wa.await_ns() == 5 * kMs);
+}
+
+TEST_CASE("Write admission: an unreadable counter source never delays",
+          "[write_admission]") {
+  uint64_t now = 0;
+  int slept = 0;
+  WriteAdmission wa(
+      params(), []() -> std::optional<DeviceReadSample> { return std::nullopt; },
+      [&] { return now; }, [&](uint64_t) { ++slept; });
+  for (int i = 0; i < 10; ++i) {
+    now += 100 * kMs;
+    REQUIRE(wa.admit() == 0);
+  }
+  REQUIRE(slept == 0);
+  REQUIRE(wa.delays() == 0);
+}
+
+TEST_CASE("Write admission: concurrent writers share one sampler",
+          "[write_admission][concurrent]") {
+  std::atomic<uint64_t> now{0};
+  std::atomic<uint64_t> reads{0};
+  std::atomic<int> samples{0};
+  std::atomic<uint64_t> slept{0};
+  WriteAdmission wa(
+      params(),
+      [&]() -> std::optional<DeviceReadSample> {
+        samples.fetch_add(1);
+        const uint64_t r = reads.load();
+        return DeviceReadSample{r, r * 4};  // every read took 4 ms
+      },
+      [&] { return now.fetch_add(kMs / 8) + kMs / 8; },
+      [&](uint64_t ns) { slept.fetch_add(ns); });
+  std::vector<std::thread> threads;
+  for (int t = 0; t < 4; ++t) {
+    threads.emplace_back([&] {
+      for (int i = 0; i < 2000; ++i) {
+        reads.fetch_add(1);
+        wa.admit();
+      }
+    });
+  }
+  for (auto& th : threads) th.join();
+  // 8000 writes over 1 s of injected time: about one sample per 50 ms
+  // window, never one per write.
+  REQUIRE(samples.load() >= 2);
+  REQUIRE(samples.load() <= 1000 / 50 + 2);
+  REQUIRE(wa.await_ns() == 4 * kMs);
+  REQUIRE(wa.delays() > 0);
+  REQUIRE(slept.load() == wa.delay_ns_total());
+}
+
+TEST_CASE("Write admission: off by default; on, writes and reads still work",
+          "[write_admission][write]") {
+  REQUIRE_FALSE(CacheConfig{}.write_admission.enabled);
+  for (const bool mmap_dir : {false, true}) {
+    CAPTURE(mmap_dir);
+    TempCacheDir tmp("write_admission");
+    CacheConfig cfg;
+    cfg.set_ram_cache_size(0);
+    cfg.set_fill_large_document_tail(true);
+    WriteAdmissionConfig wa;
+    wa.enabled = true;
+    wa.max_delay = std::chrono::microseconds(500);
+    cfg.set_write_admission(wa);
+    if (mmap_dir) {
+      cfg.set_multi_process(0, 1);
+    }
+    auto created = Cache::create(cfg);
+    REQUIRE(created.has_value());
+    auto cache = std::move(*created);
+    REQUIRE(cache->add_volume(tmp.path(), 64 * 1024 * 1024).has_value());
+    REQUIRE(cache->start().has_value());
+    for (int i = 0; i < 40; ++i) {
+      const size_t size = (i % 2 == 0) ? 300 * 1024 + i : 1000 + i;
+      std::vector<std::byte> body(size, static_cast<std::byte>(i));
+      const CacheKey key("wa-" + std::to_string(i));
+      auto wh = cache->write_sync(key, body.size());
+      REQUIRE(wh.has_value());
+      REQUIRE(wh->write_sync(body).has_value());
+      REQUIRE(wh->close_sync().has_value());
+      auto rh = cache->read_sync(key);
+      REQUIRE(rh.has_value());
+      REQUIRE(rh->content().size() == size);
+      REQUIRE(rh->content()[size - 1] == static_cast<std::byte>(i));
+    }
+    const auto st = cache->stats();
+    // Whether the device counters resolve depends on the host (none on
+    // macOS or tmpfs); either way no write sleeps longer than max_delay.
+    REQUIRE(st.write_admission_delay_us <= st.write_admission_delays * 500);
+    cache->stop();
+  }
+}
