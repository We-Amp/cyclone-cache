+#ifdef __linux__
+namespace {
+
+// /sys/dev/block/MAJ:MIN/stat of one device, kept open and re-read with
+// pread at offset 0 (sysfs regenerates the attribute on every such read).
+class SysfsBlockStat {
+ public:
+  explicit SysfsBlockStat(int fd) : _fd(fd) {}
+  SysfsBlockStat(const SysfsBlockStat&) = delete;
+  SysfsBlockStat& operator=(const SysfsBlockStat&) = delete;
+  ~SysfsBlockStat() { ::close(_fd); }
+
+  // Fields 1 and 4 of the stat file: reads completed, time reading (ms).
+  std::optional<DeviceReadSample> read() const {
+    std::array<char, 512> buf{};
+    const ssize_t n = ::pread(_fd, buf.data(), buf.size() - 1, 0);
+    if (n <= 0) {
+      return std::nullopt;
+    }
+    const char* p = buf.data();
+    const char* end = buf.data() + n;
+    std::array<uint64_t, 4> f{};
+    for (auto& v : f) {
+      while (p < end && (*p == ' ' || *p == '\t')) {
+        ++p;
+      }
+      const auto [q, ec] = std::from_chars(p, end, v);
+      if (ec != std::errc()) {
+        return std::nullopt;
+      }
+      p = q;
+    }
+    return DeviceReadSample{f[0], f[3]};
+  }
+
+ private:
+  int _fd;
+};
+
+uint64_t steady_now_ns() {
+  return static_cast<uint64_t>(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(
+          std::chrono::steady_clock::now().time_since_epoch())
+          .count());
+}
