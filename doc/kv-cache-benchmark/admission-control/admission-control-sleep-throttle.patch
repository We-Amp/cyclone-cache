+namespace cyclone {
+
+bool WriteAdmissionController::observe(uint64_t now_ns,
+                                       DeviceReadSample sample) {
+  if (!_have_base) {
+    rebase(now_ns, sample);
+    return false;
+  }
+  // Counters that went backwards (a device reset, a wrapped 32-bit field) or
+  // a clock that did: start over.
+  if (sample.reads < _base.reads || sample.read_ms < _base.read_ms ||
+      now_ns < _base_ns) {
+    reset(now_ns, sample);
+    return true;
+  }
+  const uint64_t elapsed = now_ns - _base_ns;
+  if (elapsed < _params.window_ns) {
+    return false;
+  }
+  const uint64_t reads = sample.reads - _base.reads;
+  if (elapsed >= _params.idle_ns) {
+    // Too few reads for a whole idle period (the device is idle for reads),
+    // or nobody sampled for that long (no large writes): whatever the
+    // window says is stale.  Nothing to throttle against.
+    reset(now_ns, sample);
+    return true;
+  }
+  if (reads < _params.min_reads) {
+    return false;  // extend the window until it holds enough reads
+  }
+  const double await_ns = static_cast<double>(sample.read_ms - _base.read_ms) *
+                          1e6 / static_cast<double>(reads);
+  if (_have_ewma) {
+    _ewma_ns += (await_ns - _ewma_ns) / 4.0;
+  } else {
+    _ewma_ns = await_ns;
+    _have_ewma = true;
+  }
+  const double excess = _ewma_ns - static_cast<double>(_params.target_ns);
+  const double delay = excess > 0 ? _params.gain * excess : 0.0;
+  _delay_ns = static_cast<uint64_t>(
+      std::min(delay, static_cast<double>(_params.max_delay_ns)));
+  rebase(now_ns, sample);
+  return true;
+}
+
+WriteAdmission::WriteAdmission(const WriteAdmissionParams& params,
+                               CounterSource counters, NowNs now,
+                               Sleeper sleep)
+    : _counters(std::move(counters)),
+      _now(std::move(now)),
+      _sleep(std::move(sleep)),
+      _window_ns(params.window_ns),
+      _controller(params) {}
+
+void WriteAdmission::maybe_sample(uint64_t now_ns) {
+  if (now_ns < _pub.next_sample_ns.load(std::memory_order_relaxed)) {
+    return;
+  }
+  std::unique_lock lock(_sample_mutex, std::try_to_lock);
+  if (!lock.owns_lock()) {
+    return;  // another writer is sampling; use the published delay
+  }
+  if (now_ns < _pub.next_sample_ns.load(std::memory_order_relaxed)) {
+    return;  // sampled while we were getting here
+  }
+  _pub.next_sample_ns.store(now_ns + _window_ns, std::memory_order_relaxed);
+  const std::optional<DeviceReadSample> sample = _counters();
+  if (!sample) {
+    return;
+  }
+  if (_controller.observe(now_ns, *sample)) {
+    _pub.delay_ns.store(_controller.delay_ns(), std::memory_order_relaxed);
+    _await_ns.store(_controller.await_ns(), std::memory_order_relaxed);
+  }
+}
+
+uint64_t WriteAdmission::admit() {
+  maybe_sample(_now());
+  const uint64_t delay = _pub.delay_ns.load(std::memory_order_relaxed);
+  if (delay == 0) {
+    return 0;
+  }
+  _sleep(delay);
+  _delays.fetch_add(1, std::memory_order_relaxed);
+  _delay_ns_total.fetch_add(delay, std::memory_order_relaxed);
+  return delay;
+}
