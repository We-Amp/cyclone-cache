# Apache RAT exclusions, read by tools/ci/rat.sh (the License audit CI job).
#
# One pattern per line. RAT matches each pattern against the BASE NAME of every
# file and directory it visits (not the path); a matched directory is skipped
# whole. Patterns are tried as a regular expression, an exact name and a
# wildcard, so write globs in regex form (.*\.md, not *.md).
#
# Everything not listed here must carry the Apache-2.0 SPDX header. Add an
# entry only for a file that has no comment syntax or no license-bearing
# content of its own, and say why.

# Git metadata. Listed here rather than passed as -e on the command line:
# RAT 0.16 honours EITHER -e flags OR the -E file, never both, so a single
# -e would silently disable this whole file.
.git

# Tool configuration: formatter/linter/git/audit settings, no content of their own.
.clang-format
.clang-tidy
.gitignore
.git-blame-ignore-revs
.rat-excludes

# Documentation (Markdown): covered by the repository LICENSE, no header convention.
.*\.md

# Benchmark result data (doc/kv-cache-benchmark/*.jsonl): JSON has no comment
# syntax; measurements, not authored content.
.*\.jsonl

# libFuzzer seed corpora (fuzz/corpus/*/): opaque binary test inputs.
corpus
# Raw benchmark program output (no source header applies).
.*-crc32c_bench\.txt
churn-.*\.txt
policy-replay\.txt
round5-.*\.txt
readahead-.*\.txt
insert-path-.*\.txt
# Throwaway timing patch kept with the insert-path raw data (a diff, applied
# with patch(1); not shipped source).
insert-path-.*\.patch
# Round 6 KV benchmark raw output and logs (doc/kv-cache-benchmark/round6/),
# and its per-run 1 Hz sampler files (round6-samples/<run tag>.txt).
round6-.*\.txt
round6-samples
# Small cold reads (issue #29) raw output, logs and summaries
# (doc/kv-cache-benchmark/small-reads/), and its per-run 1 Hz sampler files
# (small-reads-samples/<run tag>.txt).
small-reads-.*\.txt
small-reads-samples
