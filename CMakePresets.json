{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "ci",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++-20",
        "CYCLONE_USE_BUNDLED_SHA256": "ON"
      }
    },
    {
      "name": "ci-release",
      "displayName": "CI Release (clang-20, matches CI build-and-test)",
      "description": "Reproduces the CI build-and-test job exactly",
      "inherits": [
        "base",
        "release",
        "ci"
      ]
    },
    {
      "name": "dev",
      "displayName": "Dev (Debug, clang-20) — fast iteration",
      "description": "Debug build with the CI toolchain; the everyday build",
      "inherits": [
        "base",
        "debug",
        "ci"
      ]
    },
    {
      "name": "asan",
      "displayName": "ASan + UBSan (clang-20, matches CI asan job)",
      "description": "Address + UB sanitizers",
      "inherits": [
        "base",
        "debug",
        "ci"
      ],
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize=vptr -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "TSan (clang-20, matches CI tsan job)",
      "description": "Thread sanitizer",
      "inherits": [
        "base",
        "debug",
        "ci"
      ],
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64 Debug",
      "description": "Native Linux x86_64 debug build",
      "inherits": [
        "base",
        "debug"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-x64-release",
      "displayName": "Linux x64 Release",
      "description": "Native Linux x86_64 release build",
      "inherits": [
        "base",
        "release"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-arm64",
      "displayName": "Linux ARM64 Debug (cross)",
      "description": "Cross-compile to Linux ARM64 from x86_64",
      "inherits": [
        "base",
        "debug"
      ],
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-aarch64.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-arm64-release",
      "displayName": "Linux ARM64 Release (cross)",
      "description": "Cross-compile to Linux ARM64 from x86_64, release build",
      "inherits": [
        "base",
        "release"
      ],
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-aarch64.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS ARM64 Debug",
      "description": "Native macOS ARM64 (Apple Silicon) debug build",
      "inherits": [
        "base",
        "debug"
      ],
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-arm64-release",
      "displayName": "macOS ARM64 Release",
      "description": "Native macOS ARM64 (Apple Silicon) release build",
      "inherits": [
        "base",
        "release"
      ],
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-x64",
      "displayName": "macOS x64 Debug",
      "description": "Native macOS x86_64 (Intel) debug build",
      "inherits": [
        "base",
        "debug"
      ],
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "10.15"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-x64-release",
      "displayName": "macOS x64 Release",
      "description": "Native macOS x86_64 (Intel) release build",
      "inherits": [
        "base",
        "release"
      ],
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "10.15"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-universal",
      "displayName": "macOS Universal Debug",
      "description": "macOS Universal binary (x86_64 + arm64) debug build",
      "inherits": [
        "base",
        "debug"
      ],
      "toolchainFile": "${sourceDir}/cmake/toolchains/macos-universal.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-universal-release",
      "displayName": "macOS Universal Release",
      "description": "macOS Universal binary (x86_64 + arm64) release build",
      "inherits": [
        "base",
        "release"
      ],
      "toolchainFile": "${sourceDir}/cmake/toolchains/macos-universal.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 Debug",
      "description": "Native Windows x64 debug build with MSVC",
      "inherits": [
        "base",
        "vcpkg"
      ],
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release",
      "description": "Native Windows x64 release build with MSVC",
      "inherits": [
        "base",
        "vcpkg"
      ],
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-arm64",
      "displayName": "Windows ARM64 Debug (cross)",
      "description": "Cross-compile to Windows ARM64 with MSVC",
      "inherits": [
        "base",
        "vcpkg"
      ],
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "ARM64",
        "strategy": "set"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-windows-static"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-arm64-release",
      "displayName": "Windows ARM64 Release (cross)",
      "description": "Cross-compile to Windows ARM64 with MSVC, release build",
      "inherits": [
        "base",
        "vcpkg"
      ],
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "ARM64",
        "strategy": "set"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-windows-static",
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-x64-zig",
      "displayName": "Linux x64 via Zig (cross)",
      "description": "Cross-compile to Linux x86_64 using Zig from any host",
      "inherits": [
        "base",
        "release"
      ],
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-x64-zig.cmake",
      "cacheVariables": {
        "CYCLONE_BUILD_TESTS": "OFF",
        "CYCLONE_BUILD_EXAMPLES": "OFF",
        "CYCLONE_BUILD_BENCHMARKS": "OFF",
        "CYCLONE_USE_BUNDLED_SHA256": "ON"
      }
    },
    {
      "name": "linux-arm64-zig",
      "displayName": "Linux ARM64 via Zig (cross)",
      "description": "Cross-compile to Linux ARM64 using Zig from any host",
      "inherits": [
        "base",
        "release"
      ],
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-arm64-zig.cmake",
      "cacheVariables": {
        "CYCLONE_BUILD_TESTS": "OFF",
        "CYCLONE_BUILD_EXAMPLES": "OFF",
        "CYCLONE_BUILD_BENCHMARKS": "OFF",
        "CYCLONE_USE_BUNDLED_SHA256": "ON"
      }
    },
    {
      "name": "windows-x64-zig",
      "displayName": "Windows x64 via Zig (cross)",
      "description": "Cross-compile to Windows x86_64 using Zig from any host",
      "inherits": [
        "base",
        "release"
      ],
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-x64-zig.cmake",
      "cacheVariables": {
        "CYCLONE_BUILD_TESTS": "OFF",
        "CYCLONE_BUILD_EXAMPLES": "OFF",
        "CYCLONE_BUILD_BENCHMARKS": "OFF",
        "CYCLONE_USE_BUNDLED_SHA256": "ON"
      }
    },
    {
      "name": "windows-arm64-zig",
      "displayName": "Windows ARM64 via Zig (cross)",
      "description": "Cross-compile to Windows ARM64 using Zig from any host",
      "inherits": [
        "base",
        "release"
      ],
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-arm64-zig.cmake",
      "cacheVariables": {
        "CYCLONE_BUILD_TESTS": "OFF",
        "CYCLONE_BUILD_EXAMPLES": "OFF",
        "CYCLONE_BUILD_BENCHMARKS": "OFF",
        "CYCLONE_USE_BUNDLED_SHA256": "ON"
      }
    }
  ],
